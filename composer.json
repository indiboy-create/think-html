{
    "name": "youvision/think-html",
    "description": "基于 ThinkPHP 8 的静态网站生成器，读取 template 模板并生成静态 HTML 页面",
    "type": "library",
    "keywords": [
        "thinkphp",
        "thinkphp8",
        "static site generator",
        "html",
        "template"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "topthink/think-view": "^2.0"
    },
    "suggest": {
        "topthink/think-view": "ThinkPHP 8 项目已内置该视图包，本包使用其渲染模板，不会随包自动安装"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkHtml\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkHtml\\Service"
            ]
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "@php tests/verify.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}